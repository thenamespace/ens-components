{
  "name": "@thenamespace/ui-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "turbo run build",
    "build:components": "pnpm --filter @thenamespace/ens-components build",
    "build:storybook": "pnpm --filter storybook build",
    "build:landing": "pnpm --filter landing build",
    "dev": "turbo run dev",
    "storybook": "turbo run dev --filter=storybook",
    "landing": "turbo run dev --filter=landing",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "node scripts/check-package.mjs",
    "e2e": "pnpm --filter e2e test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "publint": "0.3.25",
    "turbo": "^2.3.3"
  }
}
