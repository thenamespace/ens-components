# Private key of a dedicated Sepolia test wallet. Never use a key that holds real funds.
# It needs Sepolia ETH (gas, ENSv1 registration, subname mints) and Sepolia USDC
# (ENSv2 registration; 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238, faucet.circle.com).
# Note: the "atomic" batch tests delegate this EOA to Simple7702Account via EIP-7702.
E2E_PRIVATE_KEY=0x..

# RPC the wallet sends through and the tests verify with. Defaults to a public Sepolia endpoint.
# E2E_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<key>

# Activated ENSv2 parents (comma separated) to mint subnames under.
# E2E_MINT_PARENTS=arti.eth,other.eth

# Parents whose subnames expire, for the renewal tests. Defaults to E2E_MINT_PARENTS.
# E2E_RENEW_PARENTS=other.eth