# Public browser configuration. Do not put secret RPC credentials in VITE_* values.
VITE_MAINNET_RPC_URL=https://eth-mainnet.example/rpc
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Optional. The Namespace production Metadata Service is used when omitted.
# VITE_METADATA_API_URL=https://metadata.namespace.ninja

# Namespace offchain parent configuration. VITE_* values are browser-visible.
VITE_OFFCHAIN_PARENT_NAME=pushx.eth
VITE_OFFCHAIN_API_KEY=your_namespace_domain_api_key

# Privy embedded signer for the pushx.eth flow. Never add a client secret here.
VITE_PRIVY_APP_ID=your_privy_app_id
VITE_PRIVY_CLIENT_ID=your_privy_client_id
